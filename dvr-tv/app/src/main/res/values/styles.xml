<resources>
    <style name="AppTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="SettingsTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#2F80ED</item>
        <item name="android:windowBackground">#FF101418</item>
    </style>
    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorHint">#6B7580</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
    </style>
    <style name="Radio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
